{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "betchya-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "betchya",
      "database_id": "779718c4-502e-4f0d-b82e-12bd29fddaaf",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "STARTING_BONES": "1000",
    "MIN_BET": "10",
    "RESOLVE_GRACE_HOURS": "48"
  }
}
