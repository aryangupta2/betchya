  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250913.0",
    "bun-types": "^1.2.21",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.37.0"
  }
}
